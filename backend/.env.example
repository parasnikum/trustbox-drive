# Server Configuration
PORT=4000
JWT_SECRET="super_secret_jwt_key_TrustBox_2026"

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://TrustBox:TrustBox_password@localhost:5432/drivebox_db?schema=public"

# =========================================================
# Cloudflare R2 Object Storage Credentials
# =========================================================
# Your Cloudflare Account ID (found in Cloudflare dashboard URL or R2 overview)
R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2 API Access Key ID
R2_ACCESS_KEY_ID="your_r2_access_key_id"
# R2 API Secret Access Key
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# R2 Bucket Name
R2_BUCKET="TrustBox-r2-primary"
# Optional Public CDN or R2 Custom Domain URL (e.g., https://pub-r2.example.com)
R2_PUBLIC_DOMAIN=""

# =========================================================
# MinIO S3 Self-Hosted Object Storage Credentials
# =========================================================
# MinIO Server Endpoint URL (e.g., http://localhost:9000 or https://minio.yourdomain.com)
MINIO_ENDPOINT="http://localhost:9000"
# MinIO Root Access Key ID
MINIO_ACCESS_KEY="minioadmin"
# MinIO Root Secret Access Key
MINIO_SECRET_KEY="minioadminpassword"
# MinIO Bucket Name
MINIO_BUCKET="TrustBox-minio-primary"
# MinIO Region (default is us-east-1)
MINIO_REGION="us-east-1"

# =========================================================
# AWS S3 Storage Credentials (Optional)
# =========================================================
AWS_S3_REGION="us-east-1"
AWS_S3_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_S3_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_S3_BUCKET="TrustBox-aws-s3"
